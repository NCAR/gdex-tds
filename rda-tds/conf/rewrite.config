# Legacy URL compatibility for the query string: ?dataset=files/g/<dsid>/... -> ?dataset=files/<dsid>/...
# The path part (/thredds/.../files/g/<dsid>/...) is handled by ingress-g-redirect.yaml; nginx path rewrites cannot touch the query.
# Rewriting with a "?" replaces the query string, so the other parameters are re-attached via %1 and %4.
RewriteCond %{QUERY_STRING} ^(.*)dataset=(files|aggregations)/g/(d[0-9]{6}.*?)(&.*)?$
RewriteRule ^(/thredds/catalog/.*)$ $1?%1dataset=%2/%3%4 [NE]
